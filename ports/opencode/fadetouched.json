{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ftAccent": "#96bb93",
    "ftPink": "#dbb5c1",
    "ftRed": "#c87a75",
    "ftOrange": "#d7a176",
    "ftYellow": "#d7be86",
    "ftGreen": "#96bb93",
    "ftTeal": "#81b8a8",
    "ftCyan": "#99c9c9",
    "ftBlue": "#7daacf",
    "ftPurple": "#af90c3",
    "ftText": "#dee1df",
    "ftTextMuted": "#b3b7b4",
    "ftTextSubtle": "#979d98",
    "ftBase": "#11201e",
    "ftPanel": "#091816",
    "ftElement": "#03100f",
    "ftSurface": "#1f2d29",
    "ftBorder": "#3e4945",
    "ftBorderActive": "#505a56",
    "ftBorderSubtle": "#2e3a36",
    "ftDiffAddedBg": "#96bb9380",
    "ftDiffRemovedBg": "#c87a7580",
    "ftDiffAddedLineBg": "#96bb9340",
    "ftDiffRemovedLineBg": "#c87a7540"
