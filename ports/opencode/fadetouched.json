    "diffRemoved": {
      "dark": "ftRed",
      "light": "ftRed"
    },
    "diffContext": {
      "dark": "ftTextSubtle",
      "light": "ftTextSubtle"
    },
    "diffHunkHeader": {
      "dark": "ftOrange",
      "light": "ftOrange"
    },
    "diffHighlightAdded": {
      "dark": "ftGreen",
      "light": "ftGreen"
    },
    "diffHighlightRemoved": {
      "dark": "ftRed",
      "light": "ftRed"
    },
    "diffAddedBg": {
      "dark": "ftDiffAddedBg",
      "light": "ftDiffAddedBg"
    },
    "diffRemovedBg": {
      "dark": "ftDiffRemovedBg",
      "light": "ftDiffRemovedBg"
    },
    "diffContextBg": {
      "dark": "ftPanel",
      "light": "ftPanel"
    },
    "diffLineNumber": {
      "dark": "ftBorderActive",
      "light": "ftBorderActive"
