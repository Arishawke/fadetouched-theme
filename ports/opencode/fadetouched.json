  "theme": {
    "primary": {
      "dark": "ftAccent",
      "light": "ftAccent"
    },
    "secondary": {
      "dark": "ftAccent",
      "light": "ftAccent"
    },
    "accent": {
      "dark": "ftPink",
      "light": "ftPink"
    },
    "error": {
      "dark": "ftRed",
      "light": "ftRed"
    },
    "warning": {
      "dark": "ftYellow",
      "light": "ftYellow"
    },
    "success": {
      "dark": "ftGreen",
      "light": "ftGreen"
    },
    "info": {
      "dark": "ftTeal",
      "light": "ftTeal"
    },
    "text": {
      "dark": "ftText",
      "light": "ftText"
    },
    "textMuted": {
      "dark": "ftTextMuted",
      "light": "ftTextMuted"
    },
    "background": {
      "dark": "ftBase",
      "light": "ftBase"
    },
    "backgroundPanel": {
      "dark": "ftPanel",
      "light": "ftPanel"
    },
    "backgroundElement": {
      "dark": "ftElement",
      "light": "ftElement"
    },
    "border": {
      "dark": "ftBorder",
      "light": "ftBorder"
    },
    "borderActive": {
      "dark": "ftBorderActive",
      "light": "ftBorderActive"
    },
    "borderSubtle": {
      "dark": "ftBorderSubtle",
      "light": "ftBorderSubtle"
    },
    "diffAdded": {
      "dark": "ftGreen",
      "light": "ftGreen"
