    "diffAddedLineNumberBg": {
      "dark": "ftDiffAddedLineBg",
      "light": "ftDiffAddedLineBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "ftDiffRemovedLineBg",
      "light": "ftDiffRemovedLineBg"
    },
