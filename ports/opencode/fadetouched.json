      "dark": "ftText",
      "light": "ftText"
    },
    "markdownHeading": {
      "dark": "ftAccent",
      "light": "ftAccent"
    },
    "markdownLink": {
      "dark": "ftBlue",
      "light": "ftBlue"
    },
    "markdownLinkText": {
      "dark": "ftCyan",
      "light": "ftCyan"
    },
    "markdownCode": {
      "dark": "ftGreen",
      "light": "ftGreen"
    },
    "markdownBlockQuote": {
      "dark": "ftYellow",
      "light": "ftYellow"
    },
    "markdownEmph": {
      "dark": "ftYellow",
      "light": "ftYellow"
    },
    "markdownStrong": {
      "dark": "ftOrange",
      "light": "ftOrange"
    },
