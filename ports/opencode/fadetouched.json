    "markdownImageText": {
      "dark": "ftCyan",
      "light": "ftCyan"
    },
    "markdownCodeBlock": {
      "dark": "ftText",
      "light": "ftText"
    },
    "syntaxComment": {
      "dark": "#666f6b",
      "light": "#666f6b"
    },
    "syntaxKeyword": {
      "dark": "#af90c3",
      "light": "#af90c3"
    },
    "syntaxFunction": {
      "dark": "#7daacf",
      "light": "#7daacf"
    },
    "syntaxVariable": {
      "dark": "ftText",
      "light": "ftText"
    },
    "syntaxString": {
      "dark": "#96bb93",
      "light": "#96bb93"
    },
    "syntaxNumber": {
      "dark": "#d7a176",
      "light": "#d7a176"
    },
    "syntaxType": {
      "dark": "#d7be86",
      "light": "#d7be86"
    },
    "syntaxOperator": {
      "dark": "#99c9c9",
      "light": "#99c9c9"
    },
    "syntaxPunctuation": {
      "dark": "#979d98",
      "light": "#979d98"
    }
  }
}
