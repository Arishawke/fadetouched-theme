# Fadetouched. Generated from palette.json. Do not edit by hand.
# Source from ~/.tmux.conf: source-file /path/to/fadetouched.tmux

set -g status on
set -g status-style "bg=#11201e,fg=#dee1df"
set -g status-left-style "bg=#11201e,fg=#96bb93,bold"
set -g status-right-style "bg=#11201e,fg=#b3b7b4"
set -g window-status-style "bg=#11201e,fg=#b3b7b4"
set -g window-status-current-style "bg=#1f2d29,fg=#dee1df,bold"
set -g window-status-activity-style "bg=#11201e,fg=#d7be86,bold"
set -g window-status-bell-style "bg=#11201e,fg=#c87a75,bold"
set -g message-style "bg=#96bb93,fg=#11201e"
set -g message-command-style "bg=#1f2d29,fg=#d7be86"
set -g pane-border-style "fg=#3e4945"
set -g pane-active-border-style "fg=#96bb93"
set -g mode-style "bg=#2e3a36,fg=#dee1df"
set -g clock-mode-colour "#96bb93"
